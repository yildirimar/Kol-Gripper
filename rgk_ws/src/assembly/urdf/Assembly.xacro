<?xml version="1.0" ?>
<robot name="Assembly" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find gripper)/urdf/gripper.urdf.xacro" />
<xacro:property name="package_path" value="$(find Assembly_description)" />
<xacro:include filename="${package_path}/urdf/materials.xacro" />
<xacro:include filename="${package_path}/urdf/Assembly.trans" />
<xacro:include filename="${package_path}/urdf/Assembly.gazebo" />
<xacro:include filename="${package_path}/urdf/Assembly.ros2_control.xacro" />

<!-- World link for Gazebo - fixes robot to ground -->
<link name="world"/>

<joint name="world_joint" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<!-- BASE LINK - Robot tabanı -->
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.158 0.053" rpy="0 0 0"/>
    <mass value="50.0"/>
    <inertia ixx="1.5" iyy="1.3" izz="1.6" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0.15 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.4 0.4 0.1"/>
    </geometry>
  </collision>
</link>

<!-- LINK 1 - İlk döner eklem -->
<link name="link1_1">
  <inertial>
    <origin xyz="0.146 -0.001 0.157" rpy="0 0 0"/>
    <mass value="15.0"/>
    <inertia ixx="0.3" iyy="0.5" izz="0.4" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.191165 -0.257989" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/link1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.13 0 0.15" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.08" length="0.35"/>
    </geometry>
  </collision>
</link>

<!-- LINK 2 - Uzun kol parçası -->
<link name="link2_1">
  <inertial>
    <origin xyz="0.0 -0.097 0.314" rpy="0 0 0"/>
    <mass value="12.0"/>
    <inertia ixx="0.5" iyy="0.5" izz="0.06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.26 -0.116165 -0.526989" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/link2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 -0.05 0.35" rpy="0 0 0"/>
    <geometry>
      <box size="0.1 0.1 0.7"/>
    </geometry>
  </collision>
</link>

<!-- LINK 3 - Orta kol parçası -->
<link name="link3_1">
  <inertial>
    <origin xyz="0.096 0.114 0.064" rpy="0 0 0"/>
    <mass value="10.0"/>
    <inertia ixx="0.18" iyy="0.36" izz="0.22" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.26 -0.086165 -1.206989" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/link3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.15 0.1 0.1" rpy="0 0 0"/>
    <geometry>
      <box size="0.35 0.15 0.2"/>
    </geometry>
  </collision>
</link>

<!-- LINK 4 - Bilek parçası -->
<link name="link4_1">
  <inertial>
    <origin xyz="0.088 0.009 0.081" rpy="0 0 0"/>
    <mass value="2.0"/>
    <inertia ixx="0.008" iyy="0.013" izz="0.009" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.626374 -0.216165 -1.512515" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/link4_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.09 0 0.08" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.05" length="0.18"/>
    </geometry>
  </collision>
</link>

<!-- LINK 5 - Uç efektör -->
<link name="link5_1">
  <inertial>
    <origin xyz="0.042 0.059 0.032" rpy="0 0 0"/>
    <mass value="1.5"/>
    <inertia ixx="0.01" iyy="0.006" izz="0.012" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.766285 -0.152165 -1.641065" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://Assembly_description/meshes/link5_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.04 0.06 0.03" rpy="0 0 0"/>
    <geometry>
      <sphere radius="0.06"/>
    </geometry>
  </collision>
</link>

<!-- JOINTS - Moderate damping, position held by ros2_control -->
<joint name="Revolute 20" type="continuous">
  <origin xyz="0.0 0.191165 0.257989" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link1_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <dynamics damping="5.0" friction="1.0"/>
</joint>

<joint name="Revolute 21" type="continuous">
  <origin xyz="0.26 -0.075 0.269" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <dynamics damping="10.0" friction="2.0"/>
</joint>

<joint name="Revolute 22" type="continuous">
  <origin xyz="0.0 -0.03 0.68" rpy="0 0 0"/>
  <parent link="link2_1"/>
  <child link="link3_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <dynamics damping="8.0" friction="1.5"/>
</joint>

<joint name="Revolute 23" type="continuous">
  <origin xyz="0.366374 0.13 0.305526" rpy="0 0 0"/>
  <parent link="link3_1"/>
  <child link="link4_1"/>
  <axis xyz="0.736369 0.0 0.67658"/>
  <dynamics damping="5.0" friction="1.0"/>
</joint>

<joint name="Revolute 24" type="continuous">
  <origin xyz="0.139911 -0.064 0.12855" rpy="0 0 0"/>
  <parent link="link4_1"/>
  <child link="link5_1"/>
  <axis xyz="-0.0 -1.0 0.0"/>
  <dynamics damping="3.0" friction="0.5"/>
</joint>

<xacro:gripper parent_link="link5_1" />

</robot>

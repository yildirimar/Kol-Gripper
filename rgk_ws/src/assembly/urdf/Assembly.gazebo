<?xml version="1.0" ?>
<robot name="Assembly" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Grey" />

<!-- Joint State Publisher Plugin - publishes joint states to ROS2 -->
<gazebo>
  <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>100</update_rate>
    <joint_name>Revolute 20</joint_name>
    <joint_name>Revolute 21</joint_name>
    <joint_name>Revolute 22</joint_name>
    <joint_name>Revolute 23</joint_name>
    <joint_name>Revolute 24</joint_name>
  </plugin>
</gazebo>

<!-- Gazebo joint settings with implicit spring damper for stability -->
<gazebo reference="Revolute 20">
  <implicitSpringDamper>true</implicitSpringDamper>
  <provideFeedback>true</provideFeedback>
  <stopCfm>0.0</stopCfm>
  <stopErp>0.2</stopErp>
</gazebo>

<gazebo reference="Revolute 21">
  <implicitSpringDamper>true</implicitSpringDamper>
  <provideFeedback>true</provideFeedback>
  <stopCfm>0.0</stopCfm>
  <stopErp>0.2</stopErp>
</gazebo>

<gazebo reference="Revolute 22">
  <implicitSpringDamper>true</implicitSpringDamper>
  <provideFeedback>true</provideFeedback>
  <stopCfm>0.0</stopCfm>
  <stopErp>0.2</stopErp>
</gazebo>

<gazebo reference="Revolute 23">
  <implicitSpringDamper>true</implicitSpringDamper>
  <provideFeedback>true</provideFeedback>
  <stopCfm>0.0</stopCfm>
  <stopErp>0.2</stopErp>
</gazebo>

<gazebo reference="Revolute 24">
  <implicitSpringDamper>true</implicitSpringDamper>
  <provideFeedback>true</provideFeedback>
  <stopCfm>0.0</stopCfm>
  <stopErp>0.2</stopErp>
</gazebo>

<!-- Link materials and physics properties -->
<gazebo reference="base_link">
  <material>Gazebo/DarkGrey</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="link1_1">
  <material>${body_color}</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>0.5</mu1>
  <mu2>0.5</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="link2_1">
  <material>${body_color}</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>0.5</mu1>
  <mu2>0.5</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="link3_1">
  <material>${body_color}</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>0.5</mu1>
  <mu2>0.5</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="link4_1">
  <material>${body_color}</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>0.5</mu1>
  <mu2>0.5</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="link5_1">
  <material>Gazebo/Red</material>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <mu1>0.8</mu1>
  <mu2>0.8</mu2>
  <selfCollide>false</selfCollide>
</gazebo>

</robot>
